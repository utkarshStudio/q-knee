{
  "name": "hqml-backend",
  "version": "1.0.0",
  "description": "HQML Backend - Hybrid Quantum-Classical Knee AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "node -e \"require('./dist/db/migrate').runMigrations()\"",
    "migrate:dev": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.5.5",
    "typescript": "^5.6.2",
    "ts-node-dev": "^2.0.0"
  }
}
