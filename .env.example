# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hqml

# Authentication
JWT_SECRET=your-jwt-secret-here-minimum-32-chars
JWT_EXPIRES_IN=7d

# Server
BACKEND_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3001

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_PORT=8000

# Dataset
RSNA_DATA_DIR=/path/to/rsna/knee/dataset
UPLOAD_DIR=./storage/uploads
MODEL_DIR=./ml-service/models

# ML Configuration
PCA_COMPONENTS=4
QUANTUM_QUBITS=4
QUANTUM_DEPTH=2
DEMO_MODE=true